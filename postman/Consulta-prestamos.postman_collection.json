    {
      "name": "200 - ADMIN consulta préstamo A",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token_admin}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/prestamos/{{prestamoA}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get(\"token_admin\") || !pm.variables.get(\"prestamoA\")) throw new Error(\"Completa los IDs de préstamos existentes y ejecuta los logins primero.\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"ADMIN consulta préstamo A: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Es el préstamo y propietario esperados\", function () {",
              "  pm.expect(String(pm.response.json().id)).to.eql(String(pm.variables.get(\"prestamoA\")));",
              "  pm.expect(String(pm.response.json().usuarioId)).to.eql(String(pm.collectionVariables.get(\"id_lectorA\")));",
              "});"
            ]
          }
        }
      ]
    },
