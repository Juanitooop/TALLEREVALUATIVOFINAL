{
  "info": {
    "name": "Consulta individual de prestamos - ADMIN y dos LECTORES",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo login y consultas. No crea, actualiza ni elimina registros. Requiere dos lectores existentes y un préstamo de cada uno. Completar variables locales. Esta colección no se ha ejecutado contra datos reales: falta el segundo lector y los préstamos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email_admin",
      "value": "admin@biblioteca.com"
    },
    {
      "key": "password_admin",
      "value": ""
    },
    {
      "key": "email_lectorA",
      "value": "lector@biblioteca.com"
    },
    {
      "key": "password_lectorA",
      "value": ""
    },
    {
      "key": "email_lectorB",
      "value": ""
    },
    {
      "key": "password_lectorB",
      "value": ""
    },
    {
      "key": "prestamoA",
      "value": ""
    },
    {
      "key": "prestamoB",
      "value": ""
    },
    {
      "key": "inexistente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"password\": \"{{password_admin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"token_admin\");",
              "if (!pm.variables.get(\"password_admin\") || !pm.variables.get(\"email_admin\")) throw new Error(\"Completa el email y la contraseña de admin en tus variables locales.\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login correcto y rol ADMIN\", function () {",
              "  pm.response.to.have.status(200);",
              "  const datos = pm.response.json();",
              "  pm.expect(datos.rol).to.eql(\"ADMIN\");",
              "  pm.expect(datos.token).to.be.a(\"string\").and.not.empty;",
              "  pm.collectionVariables.set(\"token_admin\", datos.token);",
              "  pm.collectionVariables.set(\"id_admin\", datos.id);",
              "});"
            ]
          }
        }
      ]
    },
